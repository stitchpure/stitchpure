# Copy to .env.local and fill in values. Do not commit real secrets.

# Database (required)
DATABASE_URL=postgresql://user:password@localhost:5432/stock_management

# JWT (required) — use long random strings in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string

# Single company (required) — this is a single-tenant build.
# Run `npm run db:seed` once, then paste the printed company id here.
SINGLE_COMPANY_ID=

# Seed values for `npm run db:seed` (optional; defaults exist)
SEED_COMPANY_NAME=StitchPure
SEED_COMPANY_SLUG=stitchpure
SEED_COMPANY_EMAIL=hello@stitchpure.example
SEED_COMPANY_PHONE=0000000000
SEED_COMPANY_GSTIN=
SEED_OWNER_NAME=Owner
SEED_OWNER_EMAIL=owner@stitchpure.example
SEED_OWNER_PASSWORD=ChangeMe@123

# CORS — comma-separated origins, or * for all (dev only)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Rate limiting (optional; defaults shown)
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_GENERAL_MAX=100
RATE_LIMIT_GENERAL_WINDOW_MS=900000

# Cloudinary — image uploads (optional until you use upload APIs)
# https://console.cloudinary.com/settings/api-keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
